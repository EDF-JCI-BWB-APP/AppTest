<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Formulaire de feedback de l'Ecole de la formation (EDF) de JCI BWB pour recueillir avis et commentaires sur les applications développées." />
  <title>Donne nous ton avis</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <style>
    :root, [data-theme="light"] {
      --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
      --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem);
      --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
      --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem);
      --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem);
      --text-2xl: clamp(2rem, 1.2rem + 2.5vw, 3.5rem);

      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-5: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-10: 2.5rem;
      --space-12: 3rem;
      --space-16: 4rem;

      --color-bg: #f7f6f2;
      --color-surface: #f9f8f5;
      --color-surface-2: #fbfbf9;
      --color-border: #d4d1ca;
      --color-divider: #dcd9d5;
      --color-text: #28251d;
      --color-text-muted: #6f6d67;
      --color-text-inverse: #f9f8f4;
      --color-primary: #01696f;
      --color-primary-hover: #0c4e54;
      --color-primary-highlight: #cedcd8;
      --radius-sm: 0.375rem;
      --radius-md: 0.75rem;
      --radius-lg: 1rem;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 2px rgba(40, 37, 29, 0.08);
      --shadow-md: 0 10px 30px rgba(40, 37, 29, 0.10);
      --font-body: 'DM Sans', Arial, sans-serif;
      --font-display: 'Playfair Display', Georgia, serif;
      --content-default: 1100px;
      --transition-interactive: 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-theme="dark"] {
      --color-bg: #171614;
      --color-surface: #1c1b19;
      --color-surface-2: #201f1d;
      --color-border: #393836;
      --color-divider: #262523;
      --color-text: #e3e0d8;
      --color-text-muted: #a8a39a;
      --color-text-inverse: #171614;
      --color-primary: #4f98a3;
      --color-primary-hover: #6bb3bd;
      --color-primary-highlight: #253233;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.22);
      --shadow-md: 0 10px 30px rgba(0,0,0,0.35);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: var(--font-body);
      font-size: var(--text-base);
      line-height: 1.6;
      color: var(--color-text);
      background:
        radial-gradient(circle at top left, color-mix(in srgb, var(--color-primary) 12%, transparent), transparent 32%),
        linear-gradient(180deg, var(--color-bg), var(--color-surface));
    }

    a { color: var(--color-primary); }
    img, svg, iframe { display: block; max-width: 100%; }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: var(--space-4);
      background: var(--color-primary);
      color: var(--color-text-inverse);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-full);
      z-index: 1000;
    }
    .skip-link:focus { left: var(--space-4); }

    .page-shell {
      width: min(calc(100% - 2rem), var(--content-default));
      margin: 0 auto;
      padding: var(--space-6) 0 var(--space-12);
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-8);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      text-decoration: none;
      color: inherit;
    }

    .brand-mark {
      width: 46px;
      height: 46px;
      padding: var(--space-2);
      border-radius: var(--radius-md);
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
      color: var(--color-primary);
    }

    .brand-copy strong {
      display: block;
      font-size: var(--text-sm);
      letter-spacing: 0.02em;
    }

    .brand-copy span {
      display: block;
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .theme-toggle {
      min-width: 44px;
      min-height: 44px;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface-2);
      color: var(--color-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: transform var(--transition-interactive), background var(--transition-interactive), border-color var(--transition-interactive);
    }

    .theme-toggle:hover,
    .theme-toggle:focus-visible { transform: translateY(-1px); }

    .hero {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-8);
      align-items: stretch;
      margin-bottom: var(--space-8);
    }

    .hero-card,
    .form-card,
    .contact-card {
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      backdrop-filter: blur(10px);
    }

    .hero-card {
      padding: clamp(var(--space-6), 4vw, var(--space-12));
      position: relative;
      overflow: hidden;
    }

    .hero-card::after {
      content: "";
      position: absolute;
      inset: auto -10% -18% auto;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--color-primary) 18%, transparent);
      filter: blur(10px);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      margin-bottom: var(--space-4);
      border-radius: var(--radius-full);
      background: var(--color-primary-highlight);
      color: var(--color-primary-hover);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 var(--space-4);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1.05;
      max-width: 12ch;
    }

    .lead {
      margin: 0 0 var(--space-5);
      color: var(--color-text-muted);
      max-width: 60ch;
    }

    .bullet-list {
      display: grid;
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .bullet-list li {
      display: flex;
      gap: var(--space-3);
      align-items: flex-start;
    }

    .bullet-dot {
      width: 0.8rem;
      height: 0.8rem;
      margin-top: 0.45rem;
      border-radius: 50%;
      background: var(--color-primary);
      flex: 0 0 auto;
    }

    .contact-card {
      padding: clamp(var(--space-5), 3vw, var(--space-8));
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-4);
    }

    .contact-card h2,
    .form-card h2 {
      margin: 0;
      font-size: var(--text-lg);
    }

    .contact-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      width: fit-content;
      padding: var(--space-3) var(--space-5);
      border-radius: var(--radius-full);
      background: var(--color-primary);
      color: var(--color-text-inverse);
      text-decoration: none;
      font-weight: 700;
      box-shadow: var(--shadow-sm);
    }

    .contact-link:hover,
    .contact-link:focus-visible { background: var(--color-primary-hover); }

    .form-card {
      padding: clamp(var(--space-4), 2vw, var(--space-6));
    }

    .form-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-divider);
    }

    .form-header p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--text-sm);
    }

    .form-frame {
      width: 100%;
      min-height: 720px;
      border: 0;
      border-radius: calc(var(--radius-lg) - var(--space-2));
      background: var(--color-surface-2);
    }

    .footer-note {
      margin-top: var(--space-4);
      color: var(--color-text-muted);
      font-size: var(--text-sm);
      text-align: center;
    }

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 3px;
    }

    @media (max-width: 860px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .topbar,
      .form-header {
        align-items: flex-start;
      }

      .form-header {
        flex-direction: column;
      }

      .form-frame {
        min-height: 640px;
      }
    }

    @media (max-width: 540px) {
      .page-shell {
        width: min(calc(100% - 1rem), var(--content-default));
        padding-top: var(--space-4);
      }

      h1 { max-width: none; }

      .brand-copy strong {
        font-size: var(--text-xs);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>
  <a href="#contenu" class="skip-link">Aller au contenu</a>

  <div class="page-shell">
    <header class="topbar">
      <a href="#contenu" class="brand" aria-label="Ecole de la formation de JCI BWB">
        <div class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="6" y="6" width="36" height="36" rx="10" stroke="currentColor" stroke-width="2.5"/>
            <path d="M16 30.5V17.5H23.5C27.366 17.5 30 19.785 30 23.07C30 26.358 27.366 28.5 23.5 28.5H20.6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20.5 23.5H31.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-copy">
          <strong>EDF · JCI BWB</strong>
          <span>Ecole de la formation</span>
        </div>
      </a>

      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Basculer vers le mode sombre">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </header>

    <main id="contenu">
      <section class="hero" aria-label="Présentation du formulaire">
        <div class="hero-card">
          <div class="eyebrow">Votre retour compte</div>
          <h1>Donne nous ton avis</h1>
          <p class="lead">Ce formulaire permet de recueillir vos retours, suggestions et commentaires sur les applications que nous développons au sein de l'Ecole de la formation (EDF) de JCI BWB.</p>
          <ul class="bullet-list" role="list">
            <li><span class="bullet-dot" aria-hidden="true"></span><span>Partagez votre expérience d'utilisation de manière simple et directe.</span></li>
            <li><span class="bullet-dot" aria-hidden="true"></span><span>Signalez une idée d'amélioration, un point fort ou un problème rencontré.</span></li>
            <li><span class="bullet-dot" aria-hidden="true"></span><span>Aidez-nous à concevoir des outils plus utiles pour notre communauté.</span></li>
          </ul>
        </div>

        <aside class="contact-card" aria-label="Contact">
          <h2>Contact</h2>
          <p>Pour toute question complémentaire ou un retour direct, vous pouvez également nous écrire par email.</p>
          <a class="contact-link" href="mailto:ecoledeformationjci@gmail.com">ecoledeformationjci@gmail.com</a>
          <p>Merci pour votre temps et votre contribution à l'amélioration de nos applications.</p>
        </aside>
      </section>

      <section class="form-card" aria-labelledby="formulaire-titre">
        <div class="form-header">
          <div>
            <h2 id="formulaire-titre">Formulaire de feedback</h2>
            <p>Remplissez le formulaire ci-dessous pour nous transmettre votre avis.</p>
          </div>
        </div>

        <iframe
          class="form-frame"
          src="https://twisty-time-d9b.notion.site/ebd//3747e056766380ffa4b1d2b011e39f68"
          title="Formulaire de feedback EDF JCI BWB"
          width="100%"
          height="720"
          frameborder="0"
          allowfullscreen>
        </iframe>

        <p class="footer-note">Si le formulaire ne s'affiche pas correctement, utilisez l'adresse de contact indiquée plus haut.</p>
      </section>
    </main>
  </div>

  <script>
    (function () {
      const root = document.documentElement;
      const button = document.querySelector('[data-theme-toggle]');
      let theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      const renderIcon = (mode) => {
        button.innerHTML = mode === 'dark'
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
        button.setAttribute('aria-label', mode === 'dark' ? 'Basculer vers le mode clair' : 'Basculer vers le mode sombre');
      };

      root.setAttribute('data-theme', theme);
      renderIcon(theme);

      button.addEventListener('click', function () {
        theme = theme === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', theme);
        renderIcon(theme);
      });
    })();
  </script>
</body>
</html>
